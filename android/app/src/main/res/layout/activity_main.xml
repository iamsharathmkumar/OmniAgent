<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070A12"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- SKAI Humanoid Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◉"
                android:textColor="#00E5FF"
                android:textSize="28sp"
                android:layout_marginEnd="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SKAI Humanoid Agent"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_core_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HANDS-FREE WAKE: ACTIVE (Say 'SKAI')"
                    android:textColor="#00E5FF"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_toggle_overlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARC HUD"
                android:textSize="11sp"
                android:backgroundTint="#0891B2"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Zero-Touch Notice Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#052E2B"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️"
                android:textSize="18sp"
                android:layout_marginEnd="10dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ZERO-TOUCH ACTIVE: You never need to touch the phone. Speak naturally: 'SKAI, install Subway Surfers' or 'SKAI, play Queen on YouTube'."
                android:textColor="#A7F3D0"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- System Capabilities Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0E1626"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM PERMISSIONS AND SUB-SYSTEMS"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_service_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accessibility Service: CHECKING..."
                android:textColor="#F87171"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />

            <Button
                android:id="@+id/btn_enable_accessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Engage Accessibility Engine (Controls Screen)"
                android:backgroundTint="#1E293B"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btn_grant_overlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Engage Floating Arc HUD (Screen Overlay)"
                android:backgroundTint="#1E293B"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_grant_audio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Engage Microphone Sensor (Zero-Touch Voice)"
                android:backgroundTint="#1E293B"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Voice & Playbook Command Center -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0E1626"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HUMANOID AUTONOMOUS PLAYBOOKS"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <EditText
                    android:id="@+id/et_command"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Type or speak to SKAI..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#475569"
                    android:background="#070A12"
                    android:padding="12dp"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_mic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎙️ Speak"
                    android:backgroundTint="#00E5FF"
                    android:textColor="#070A12"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp" />

                <Button
                    android:id="@+id/btn_execute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Send"
                    android:backgroundTint="#0284C7"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Humanoid Test Commands -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complex Hands-Free Autonomous Commands:"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:layout_marginTop="10dp" />

            <Button
                android:id="@+id/btn_chip_install"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📥 'SKAI, install Subway Surfers on Play Store'"
                android:backgroundTint="#162032"
                android:textColor="#67E8F9"
                android:textSize="11sp"
                android:gravity="start|center_vertical"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_chip_youtube"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▶️ 'SKAI, play Interstellar soundtrack on YouTube'"
                android:backgroundTint="#162032"
                android:textColor="#F43F5E"
                android:textSize="11sp"
                android:gravity="start|center_vertical"
                android:layout_marginTop="4dp" />

            <Button
                android:id="@+id/btn_chip_photo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📸 'SKAI, take a photo / take a selfie'"
                android:backgroundTint="#162032"
                android:textColor="#FBBF24"
                android:textSize="11sp"
                android:gravity="start|center_vertical"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btn_chip_torch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ Flashlight"
                    android:backgroundTint="#162032"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_chip_volume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔊 Volume Up"
                    android:backgroundTint="#162032"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_chip_battery"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔋 Diagnostics"
                    android:backgroundTint="#162032"
                    android:textColor="#38BDF8"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Cloud LLM Configuration (Gemini / OpenAI) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0E1626"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GEMINI MULTIMODAL REASONING (OPTIONAL)"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Enter your free Google Gemini API key to enable visual screen comprehension:"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/et_api_key"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Enter Gemini API key (starts with AIza)..."
                    android:textColor="#FFFFFF"
                    android:textColorHint="#475569"
                    android:background="#070A12"
                    android:padding="10dp"
                    android:textSize="11sp"
                    android:inputType="textPassword" />

                <Button
                    android:id="@+id/btn_save_key"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save"
                    android:backgroundTint="#0284C7"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Live Diagnostics & Logs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#050811"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SKAI LIVE REASONING STREAM"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:fontFamily="monospace" />

            <ScrollView
                android:id="@+id/scroll_logs"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/tv_logs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SKAI System online. Hands-free hotword active: Say 'SKAI' followed by any command."
                    android:textColor="#67E8F9"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </ScrollView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
